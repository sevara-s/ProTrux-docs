        Y_B["Y.Doc"]
        IDB_B[("IndexedDB")]
        SM_B["Sync state machine"]

        UI_B <--> Y_B
        Y_B <--> IDB_B
        Y_B <--> SM_B
    end

    subgraph Hub ["Node.js · Fastify"]
        WS["WebSocket /ws/:docId"]
        Rooms["y-websocket rooms"]
